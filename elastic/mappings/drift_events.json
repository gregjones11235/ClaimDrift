      "usage": { "type": "object", "enabled": false },
      "preprint_title": { "type": "text" },
      "published_title": { "type": "text" },
      "first_author": { "type": "keyword" },
      "machine_verdict": { "type": "object", "enabled": false },
      "corrected_fields": { "type": "keyword" }
    }
