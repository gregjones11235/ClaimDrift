{
  "settings": {
    "refresh_interval": "5s"
  },
  "mappings": {
    "dynamic": "strict",
    "properties": {
      "record_source": { "type": "keyword" },
      "event_id": { "type": "keyword" },
      "preprint_doi": { "type": "keyword" },
      "preprint_version_compared": { "type": "keyword" },
      "published_doi": { "type": "keyword" },
      "detected_at": { "type": "date" },
      "analyzed_at": { "type": "date" },
      "drift_summary": { "type": "text" },
      "claim_diffs": {
        "type": "nested",
        "properties": {
          "diff_type": { "type": "keyword" },
          "preprint_claim_id": { "type": "keyword" },
          "published_claim_id": { "type": "keyword" },
          "preprint_text": { "type": "text" },
          "published_text": { "type": "text" },
          "change_description": { "type": "text" },
          "numerical_delta": {
            "properties": {
              "metric": { "type": "keyword" },
              "preprint_value": { "type": "float" },
              "published_value": { "type": "float" },
              "absolute_delta": { "type": "float" },
              "relative_delta": { "type": "float" }
            }
          }
        }
      },
      "materiality_score": { "type": "float" },
      "retrieved_patterns_used": { "type": "keyword" }
    }
  }
}
