# Copy to .env (gitignored). claimdrift/config.py reads it at import; real environment variables take precedence.

# Gemini through the AI Studio API key (all five agents, the citation workers, the self-check judge)
GEMINI_API_KEY=
GOOGLE_GENAI_USE_VERTEXAI=false

# GCP project for Agent Engine / Cloud Run / Cloud Build (deploy scripts, ID tokens for the MCP service)
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=us-central1

# Elasticsearch Serverless data-plane host (the .es. host), e.g. https://<id>.es.<region>.gcp.cloud.es.io
ELASTIC_ENDPOINT=
ELASTIC_API_KEY=
# Kibana host (the .kb. host) -- only for the Elastic Workflow that triggers the automatic pipeline
KIBANA_URL=

# Gmail OAuth token for notifications (created by claimdrift/scripts/gmail_oauth_local.py); absolute path
GMAIL_TOKEN_FILE=

# Optional overrides (defaults: the cloud system; see claimdrift/config.py)
# CLAIMDRIFT_LOCAL=1            local stack: docker ES on :9200, stdio MCP, agents in-process
# CLAIMDRIFT_ES= CLAIMDRIFT_MCP_URL= CLAIMDRIFT_ENGINES= CLAIMDRIFT_DATA=
