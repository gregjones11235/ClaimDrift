# Copy to .env for local development (gitignored).
# In Cloud Run these are set via --set-env-vars and --set-secrets flags.

# GCP project hosting the supervisor reasoning engine + Secret Manager
GCP_PROJECT=tensile-topic-496519-i1
GCP_REGION=us-central1

# Supervisor agent reasoning engine ID (Phase 5f-i deploy)
SUPERVISOR_REASONING_ENGINE_ID=7816826734824652800

# Elastic cluster
# Note: ELASTIC_ENDPOINT is the ES URL (*.es.*), distinct from Kibana URL (*.kb.*).
# Use the ES endpoint directly for HTTP REST against indices.
ELASTIC_ENDPOINT=https://<your-deployment>.es.us-central1.gcp.cloud.es.io
ELASTIC_API_KEY=<base64-encoded api key, gitignored>

# Bearer token Elastic Workflow YAML sends in Authorization header
# Generate once: python -c "import secrets; print(secrets.token_urlsafe(32))"
WF_BEARER_TOKEN=<random 32-char string>

# Local-dev only: skip live supervisor call, replay _stub_stream.json instead.
# Leave UNSET in Cloud Run.
USE_STUB_STREAM=

# Demo helper: when set, any notification with no recipient_email (citation_finder
# v0 limitation — author emails are always null at the agent boundary) gets sent
# to this address so the demo pipeline visibly delivers mail. Leave UNSET in
# production; recipient enrichment is a future cross-agent change.
DEMO_FALLBACK_EMAIL=
